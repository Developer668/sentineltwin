# Local-only configuration. Copy to .env; never commit .env.
AWS_REGION=us-west-2
AWS_PROFILE=default
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# CockroachDB Cloud is the sole persistent database. Always require TLS.
DATABASE_URL=postgresql://sentinel_app:REPLACE_ME@REPLACE_ME:26257/sentineltwin?sslmode=verify-full
COCKROACH_CLUSTER=sentineltwin
COCKROACH_REGION=us-west-2
COCKROACH_PLAN=basic
COCKROACH_SPEND_LIMIT=15
# Existing three-region clusters only; `make db-multi-region` is a dry run unless explicitly confirmed.
COCKROACH_REGIONS=
COCKROACH_PRIMARY_REGION=
MULTI_REGION_APPLY=false
MULTI_REGION_CONFIRM=

# Browser/API configuration.
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://127.0.0.1:8787
SENTINEL_DEMO_MODE=true
SENTINEL_APPLY_DEMO_FIXTURES=false
LOG_LEVEL=INFO

# AWS deployment defaults. `public` requires SENTINEL_DEMO_MODE=true and an empty DATABASE_SECRET_ARN.
AUTH_MODE=cognito
SENTINEL_SAM_BUILD_MODE=container
COGNITO_DOMAIN_PREFIX=
ARTIFACT_BUCKET_NAME=
SATELLITE_INPUT_PREFIX=sentineltwin/quarantine/
SATELLITE_IMPORT_MAX_BYTES=12000000
GUARDDUTY_MALWARE_PROTECTION_ENABLED=true
API_RESERVED_CONCURRENCY=0
INGESTION_RESERVED_CONCURRENCY=0
API_DETAILED_METRICS_ENABLED=false
API_THROTTLE_BURST_LIMIT=40
API_THROTTLE_RATE_LIMIT=20
DATABASE_POOL_MAX_SIZE=4

# Public SPA identifiers are resolved automatically by `make deploy-web`.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_SCOPES="openid email profile"

# Set after creating the AWS secret/deploying the stack. Do not put a token here in source control.
DATABASE_SECRET_ARN=
STACK_NAME=sentineltwin

# Deployed smoke tests only. Treat bearer tokens like passwords; never commit a value.
API_BEARER_TOKEN=

# Read-only by default. Write load additionally requires SENTINEL_LOAD_ALLOW_WRITES=true.
API_BASE_URL=http://127.0.0.1:8787/api
LOAD_DURATION=15
LOAD_CONCURRENCY=8
SENTINEL_LOAD_TOKEN=
SENTINEL_LOAD_ALLOW_WRITES=false
